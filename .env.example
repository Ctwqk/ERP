# Copy to .env (`cp .env.example .env`) before `docker compose up`.
# These are LOCAL DEVELOPMENT values only. Change every password before exposing anything beyond localhost.

# --- PostgreSQL (one server, one database per service; see docker/postgres/init) ---
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp-dev-postgres

# --- RabbitMQ ---
RABBITMQ_USER=erp
RABBITMQ_PASSWORD=erp-dev-rabbit

# --- MinIO (S3-compatible object storage; the password needs at least 8 characters) ---
MINIO_ROOT_USER=erp-minio
MINIO_ROOT_PASSWORD=erp-dev-minio
MINIO_BUCKET=erp-assets

# --- First administrator, created by user-service on first start (needs at least 8 characters) ---
ERP_ADMIN_EMAIL=admin@erp.local
ERP_ADMIN_PASSWORD=erp-dev-admin

# --- JWT signing key. Empty = a fresh key on every start of user-service (tokens die on restart).
# To keep one key: create a PKCS12 keystore, mount it into the container and set these (see README).
AUTH_KEYSTORE_LOCATION=
AUTH_KEYSTORE_PASSWORD=
AUTH_KEY_ALIAS=auth-rsa
AUTH_KEY_PASSWORD=

# --- Host ports (everything is bound to 127.0.0.1) ---
USER_SERVICE_PORT=41801
ITEM_SERVICE_PORT=41802
INVENTORY_SERVICE_PORT=41803
TASK_SERVICE_PORT=41805
NOTIFICATION_SERVICE_PORT=41806
POSTGRES_PORT=41432
RABBITMQ_PORT=41672
RABBITMQ_UI_PORT=41673
MINIO_API_PORT=41900
MINIO_CONSOLE_PORT=41901
